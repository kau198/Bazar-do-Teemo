# -------------------------------------------------------
# Banco de dados Neon (PostgreSQL 18)
# Obtenha a connection string em: https://console.neon.tech
#   1. Crie um projeto e um banco de dados.
#   2. Na aba "Connection Details", selecione "Connection string".
#   3. Cole o valor abaixo (formato: postgres://user:senha@host/dbname?sslmode=require)
# -------------------------------------------------------
DATABASE_URL='postgresql://neondb_owner:npg_Xgalq6VQnSB1@ep-quiet-leaf-bdd3ose4-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# -------------------------------------------------------
# Segredo para assinar cookies de sessão
# Gere um valor aleatório forte (ex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# -------------------------------------------------------
SESSION_SECRET="receba1234"

# -------------------------------------------------------
# Ambiente de execução: development | production
# -------------------------------------------------------
NODE_ENV=development

# -------------------------------------------------------
# Porta do servidor HTTP
# -------------------------------------------------------
PORT=3000
